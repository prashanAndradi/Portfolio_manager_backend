# Environment variables required by the backend.
#
# Copy to .env for local work, and set the same keys in each deployed
# environment (App Runner / Lambda service configuration). Values here are
# placeholders - never commit real secrets.

# --- Database -----------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ITMS-LV1

# --- App ----------------------------------------------------------------
PORT=3001
NODE_ENV=production
JWT_SECRET=

# Bypasses authentication entirely. Only ever set alongside
# NODE_ENV=development, never in a deployed environment.
# SKIP_AUTH=true

# --- Paths / URLs -------------------------------------------------------
CLOUD_UPLOAD_PATH=
CLOUD_TRANSACTION_DOCUMENTS_PATH=
PUBLIC_PATH_PREFIX=
PUBLIC_BASE_URL=
FRONTEND_URL=

# --- Mail ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2
MAX_RESET_ATTEMPTS_PER_HOUR=5

# --- External accounting API --------------------------------------------
# Backs the Trial Balance and GSec Balance Sheet screens. The backend proxies
# these server-to-server (the external API's CORS policy blocks the browser)
# and signs in with a dedicated service account - this app's own user tokens
# are not valid there.
#
# REQUIRED IN EVERY DEPLOYED ENVIRONMENT. Without them both screens fail with
# "The external accounting service is not configured on this server".
# Check any environment with: GET /api/external-accounting/health (admin).
EXTERNAL_ACCOUNTING_API_BASE_URL=https://vc1bp9jg70.execute-api.us-east-1.amazonaws.com/prod
EXTERNAL_ACCOUNTING_API_EMAIL=
EXTERNAL_ACCOUNTING_API_PASSWORD=
